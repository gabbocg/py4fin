% Reading list for ENGIN 604 --- Introduction to Python for Finance.
%
% Every entry here is printed in the generated "Recommended Readings"
% section, because index.qmd sets the nocite key to a star. Do not write
% that key literally in this file: BibTeX reads an at-sign as the start of
% an entry even inside a percent comment, and drops the entry that follows.
%
% Citations go through natbib/BibTeX rather than citeproc, so TITLES ARE
% DOUBLE-BRACED. BibTeX lowercases a singly-braced title under the
% `apalike` style, which would turn "Pandas, NumPy, and IPython" into
% "pandas, numpy, and ipython".

@book{mckinney2017python,
  title     = {{Python for Data Analysis: Data Wrangling with Pandas, NumPy, and IPython}},
  author    = {McKinney, Wes},
  year      = {2017},
  edition   = {2},
  publisher = {O'Reilly Media, Inc.}
}

@book{ramalho2015fluent,
  title     = {{Fluent Python: Clear, Concise, and Effective Programming}},
  author    = {Ramalho, Luciano},
  year      = {2015},
  publisher = {O'Reilly Media, Inc.}
}

@book{vanderplas2016python,
  title     = {{Python Data Science Handbook: Essential Tools for Working with Data}},
  author    = {VanderPlas, Jake},
  year      = {2016},
  publisher = {O'Reilly Media, Inc.}
}

@techreport{sheppard2019introduction,
  title       = {{Introduction to Python for Econometrics, Statistics and Data Analysis}},
  author      = {Sheppard, Kevin},
  year        = {2019},
  note        = {Version 3},
  institution = {Self-published, University of Oxford}
}
